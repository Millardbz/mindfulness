# =========================================================================
# Circle of Mindfulness — environment variables
# Copy this file to `.env.local` and fill in the values.
# Everything still builds & runs with placeholders; Sanity-driven content
# simply falls back to bundled defaults until you add a real project id.
# =========================================================================

# --- Site -----------------------------------------------------------------
# Public base URL, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://circleofmindfulness.dk

# --- Sanity (required for the CMS / blog / studio at /studio) -------------
# Find these in https://sanity.io/manage  ->  your project  ->  API
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Optional: a read token (only needed for draft/preview or private datasets)
# Create one with "Viewer" rights under API -> Tokens
SANITY_API_READ_TOKEN=

# Optional: secret used by the /api/revalidate webhook (any random string)
SANITY_REVALIDATE_SECRET=

# --- Contact form (optional) ---------------------------------------------
# The /kontakt form works without these (it just won't send email until set).
# Get a key at https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Circle of Mindfulness <onboarding@resend.dev>
